# Copy to .env and configure privately. Never commit real API keys.
RESEND_API_KEY=
# Use a sender on your verified Resend domain.
MAIL_FROM=Workend <verifikasi@example.com>
# Production geocoding: identify your deployed app and operator contact.
GEOCODER_USER_AGENT=Workend/1.0 (contact: operator@example.com)
GEOCODER_URL=https://nominatim.openstreetmap.org/search
# Twilio Verify SMS. Configure the service with Code Length = 6.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Application-wide daily SMS request ceiling (also 5/day per account/number).
SMS_DAILY_LIMIT=100
